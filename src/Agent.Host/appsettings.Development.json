{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Api": {
    "DevSigningKey": "development-only-signing-key-change-me-0123456789"
  },
  "Authorization": {
    "Provider": "Static",
    "StaticGroups": {
      "dev": [ "/agent/admin" ]
    }
  },
  "Persistence": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=agent-dev.db"
  },
  "Telemetry": {
    "Environment": "development",
    "ConsoleExporter": false
  }
}
