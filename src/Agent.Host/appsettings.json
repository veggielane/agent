{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http": "Warning"
    }
  },

  "Api": {
    "Enabled": true,
    "ListenUrl": "http://localhost:5080",
    "ConversationHistory": 40
  },

  "Llm": {
    "BaseUrl": "https://llm.internal/v1",
    "ApiKey": "<set via user-secrets or Llm__ApiKey>",
    "AnswerModel": "default-answer-model",
    "CodingModel": "default-coding-model",
    "Overrides": {},
    "AllowClientModelOverride": false,
    "TimeoutSeconds": 120,
    "MaxOutputTokens": 1500,
    "MaxToolIterations": 20
  },

  "Authorization": {
    "Provider": "Keycloak",
    "Roles": {
      "Users": [ "/agent/users" ],
      "Team": [ "/agent/team" ],
      "Admin": [ "/agent/admin" ]
    },
    "CacheMinutes": 10,
    "DenyBehaviour": "Silent"
  },

  "Keycloak": {
    "Authority": "https://sso.corp.local/realms/corp",
    "ApiAudience": "agent-api",
    "CliClientId": "agent-cli",
    "Admin": {
      "ClientId": "agent-service",
      "ClientSecret": "<secret>"
    }
  },

  "Ldap": {
    "Enabled": false,
    "Server": "dc01.corp.local",
    "Port": 636,
    "UseSsl": true,
    "BaseDn": "DC=corp,DC=local",
    "BindDn": "",
    "BindPassword": ""
  },

  "Persistence": {
    "Provider": "SqlServer",
    "ConnectionString": "",
    "MigrateOnStartup": true,
    "RetentionDays": 90
  },

  "Commands": {
    "Prefix": "!",
    "Directory": "commands",
    "ReplyToUnknown": true
  },

  "Prompts": {
    "Directory": "prompts"
  },

  "Mcp": {
    "Directory": "mcp",
    "MaxResultChars": 20000,
    "Servers": {}
  },

  "Coding": {
    "MaxConcurrentTasks": 2,
    "Budget": {
      "MaxTurns": 60,
      "MaxTokens": 400000,
      "MaxMinutes": 30,
      "MaxRuns": 25
    },
    "BranchPrefix": "agent/",
    "OpenAsDraft": false,
    "KeepFailedWorkspacesDays": 3
  },

  "Mattermost": {
    "Enabled": true,
    "BaseUrl": "",
    "BotToken": "<secret>",
    "RespondToDirectMessages": true,
    "RespondToMentions": true,
    "GroupMessagesRequireMention": true,
    "ThreadFollowMinutes": 120,
    "DmHistoryMessages": 30,
    "ChannelAllowList": []
  },

  "Jira": {
    "Enabled": true,
    "BaseUrl": "",
    "Username": "agent-bot",
    "Token": "<secret>",
    "BotUsername": "agent-bot",
    "PollSeconds": 30,
    "OverlapMinutes": 2,
    "Projects": [],
    "TaskLabel": "agent",
    "RepositoryField": "",
    "ProjectRepos": {}
  },

  "GitLab": {
    "Enabled": true,
    "BaseUrl": "",
    "Token": "<secret>",
    "BotUsername": "agent-bot",
    "PollSeconds": 30,
    "Groups": [],
    "TaskLabel": "agent",
    "TaskOnAssign": true,
    "FollowUpsOnForeignMrs": false
  }
}
